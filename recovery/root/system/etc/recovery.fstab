# Android fstab file.
# <device> <mount point> <fstype> <flags>

/dev/block/bootdevice/by-name/system      /system      ext4    ro,barrier=1,discard                        wait,slotselect,first_stage_mount
/dev/block/bootdevice/by-name/vendor      /vendor      ext4    ro,barrier=1,discard                        wait,slotselect,first_stage_mount
/dev/block/bootdevice/by-name/product     /product     ext4    ro,noatime,nosuid,nodev,barrier=1           wait,slotselect,first_stage_mount

/dev/block/bootdevice/by-name/userdata    /data        ext4    noatime,nosuid,nodev,barrier=1,noauto_da_alloc,discard  latemount,wait,check,quota,reservedsize=128M,fileencryption=aes-256-xts:aes-256-cts
/dev/block/bootdevice/by-name/userdata    /data        f2fs    noatime,nosuid,nodev,barrier=1,noauto_da_alloc,discard  latemount,wait,check,quota,reservedsize=128M,fileencryption=aes-256-xts:aes-256-cts

/dev/block/bootdevice/by-name/misc        /misc        emmc    defaults                                    defaults
/dev/block/bootdevice/by-name/config      /frp         emmc    defaults                                    defaults
/dev/block/bootdevice/by-name/misc        /misc        emmc    defaults                                    defaults
/dev/block/bootdevice/by-name/persist     /mnt/vendor/persist ext4   noatime,nosuid,nodev,barrier=1        wait
